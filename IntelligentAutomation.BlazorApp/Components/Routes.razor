@using IntelligentAutomation.BlazorApp.Components.Pages

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(AuthenticatedLayout)">
            <NotAuthorized>
                <RouteView RouteData="routeData" />
            </NotAuthorized>
            <Authorizing>
                <LayoutView Layout="typeof(PublicLayout)">
                    <p>Autorizando...</p>
                </LayoutView>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Não Encontrado</PageTitle>
        <LayoutView Layout="typeof(AuthenticatedLayout)">
            <p role="alert">Desculpe, não há nada neste endereço.</p>
        </LayoutView>
    </NotFound>
</Router>