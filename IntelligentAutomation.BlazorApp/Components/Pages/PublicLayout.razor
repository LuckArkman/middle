@inherits LayoutComponentBase

<div class="public-layout">
    <header class="top-header">
        <nav class="container">
            <a class="logo" href="/">
                <span class="bi bi-robot"></span> AutoAgent
            </a>
            <div class="nav-links">
                <a href="#how-it-works">Como Funciona</a>
                <a href="#features">Funcionalidades</a>
                <a href="#pricing">Preços</a>
                <a href="#contact">Contato</a>
            </div>
            <div class="auth-buttons">
                <a href="Account/Login" class="btn btn-secondary">Entrar</a>
                <a href="Account/Register" class="btn btn-primary">Começar Agora</a>
            </div>
        </nav>
    </header>

    <main>
        @Body
    </main>

    <footer class="main-footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <h4><span class="bi bi-robot"></span> AutoAgent</h4>
                    <p>Plataforma líder em automação inteligente. Crie agentes autônomos que transformam a produtividade do seu negócio.</p>
                    <div class="social-icons">
                        <a href="#" aria-label="LinkedIn"><span class="bi bi-linkedin"></span></a>
                        <a href="#" aria-label="Twitter"><span class="bi bi-twitter-x"></span></a>
                        <a href="#" aria-label="Email"><span class="bi bi-envelope-fill"></span></a>
                    </div>
                </div>
                <div class="footer-links">
                    <div>
                        <h5>Produto</h5>
                        <a href="#features">Funcionalidades</a>
                        <a href="#pricing">Preços</a>
                        <a href="#how-it-works">Como Funciona</a>
                        <a href="#">Documentação</a>
                    </div>
                    <div>
                        <h5>Empresa</h5>
                        <a href="#">Sobre Nós</a>
                        <a href="#contact">Contato</a>
                        <a href="#">Política de Privacidade</a>
                        <a href="#">Termos de Uso</a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; @DateTime.Now.Year AutoAgent. Todos os direitos reservados.
            </div>
        </div>
    </footer>
</div>