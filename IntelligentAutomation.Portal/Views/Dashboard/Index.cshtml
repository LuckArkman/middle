@model List<IntelligentAutomation.Domain.Entities.Agent>
@{
    ViewData["Title"] = "Meu Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0">Meus Agentes</h1>
        <p class="text-secondary small">Seu plano atual: <span class="badge bg-primary">@(ViewBag.PlanName ?? "Grátis")</span></p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Criar Agente</a>
</div>

<div class="row g-4">
    @foreach (var agent in Model)
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="card-title mb-0">@agent.Name</h5>
                        <span class="badge @(agent.Status == IntelligentAutomation.Domain.Enums.AgentStatus.Running ? "bg-success" : "bg-warning")">
                            @agent.Status
                        </span>
                    </div>
                    <p class="text-secondary small">Modelo: @agent.LlmType</p>
                    <div class="mt-4 d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@agent.Id" class="btn btn-outline-info btn-sm flex-grow-1">
                            <i class="bi bi-search me-1"></i>Detalhes
                        </a>
                        @if (agent.Status == IntelligentAutomation.Domain.Enums.AgentStatus.Running)
                        {
                            <form asp-action="Stop" asp-route-id="@agent.Id" method="post">
                                <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-stop-fill"></i></button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Start" asp-route-id="@agent.Id" method="post">
                                <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-play-fill"></i></button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <i class="bi bi-robot display-1 text-secondary opacity-25"></i>
            <p class="mt-3 text-secondary">Você ainda não tem nenhum agente criado.</p>
        </div>
    }
</div>