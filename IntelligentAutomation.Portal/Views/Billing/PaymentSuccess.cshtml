@{
    ViewData["Title"] = "Pagamento Realizado";
}

<div class="text-center py-5">
    <div class="display-1 text-success mb-4"><i class="bi bi-check-circle"></i></div>
    <h1 class="fw-bold mb-3">@ViewBag.Message</h1>
    <p class="text-secondary mb-4">Em alguns instantes seu plano será ativado. Você pode acompanhar pelo Dashboard.</p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-lg px-5">Voltar ao Dashboard</a>
</div>
