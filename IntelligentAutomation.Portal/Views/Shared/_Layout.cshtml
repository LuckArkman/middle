<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Intelligent Automation SaaS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        :root {
            --primary-bg: #0f172a;
            --secondary-bg: #1e293b;
            --accent-color: #38bdf8;
            --text-main: #f8fafc;
        }
        body {
            background-color: var(--primary-bg);
            color: var(--text-main);
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }
        .navbar {
            background-color: var(--secondary-bg) !important;
            border-bottom: 1px solid #334155;
        }
        .card {
            background-color: var(--secondary-bg);
            border: 1px solid #334155;
            color: var(--text-main);
        }
        .btn-primary {
            background-color: var(--accent-color);
            border: none;
        }
        .sidebar {
            min-height: calc(100vh - 56px);
            background-color: var(--secondary-bg);
            border-right: 1px solid #334155;
        }
        .nav-link {
            color: #94a3b8;
        }
        .nav-link:hover, .nav-link.active {
            color: var(--accent-color);
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-robot me-2"></i>Intelligent Automation
            </a>
            <div class="d-flex">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="navbar-text me-3">
                        <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-outline-light btn-sm">Sair</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm me-2">Login</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">Começar Agora</a>
                }
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav class="col-md-2 d-none d-md-block sidebar py-4">
                    <ul class="nav flex-column px-3">
                        <li class="nav-item mb-2">
                            <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2 me-2"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a class="nav-link" asp-controller="Dashboard" asp-action="Create">
                                <i class="bi bi-plus-circle me-2"></i>Novo Agente
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a class="nav-link" asp-controller="Billing" asp-action="Index">
                                <i class="bi bi-credit-card me-2"></i>Assinatura
                            </a>
                        </li>
                    </ul>
                </nav>
                <main class="col-md-10 ms-sm-auto px-md-4 py-4">
                    @RenderBody()
                </main>
            }
            else
            {
                <main class="col-12 py-4">
                    @RenderBody()
                </main>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
