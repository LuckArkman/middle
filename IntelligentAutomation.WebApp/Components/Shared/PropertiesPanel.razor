@using IntelligentAutomation.Domain.Entities
@using IntelligentAutomation.Domain.Workflow

@if (SelectedNode is ModuleNode moduleNode && moduleNode.Parameters != null)
{
    <div class="properties-panel">
        <h4>Propriedades: @moduleNode.Name</h4>
        <hr />

        @if (_manifestForNode != null)
        {
            <EditForm Model="moduleNode.Parameters" Context="editContext">
                <DataAnnotationsValidator />
                
                @foreach (var param in _manifestForNode.Parameters)
                {
                    <div class="mb-3">
                        <label class="form-label">@param.DisplayName</label>
                        @switch (param.Type)
                        {
                            // ---- INÍCIO DA CORREÇÃO ----
                            case "string":
                                <InputText class="form-control" 
                                           Value="@GetStringProperty(moduleNode.Parameters, param.Name)" 
                                           ValueChanged="@((string value) => SetStringProperty(moduleNode.Parameters, param.Name, value))" />
                                break;
                            case "number":
                                <InputNumber class="form-control" 
                                             Value="@GetDecimalProperty(moduleNode.Parameters, param.Name)" 
                                             ValueChanged="@((decimal value) => SetDecimalProperty(moduleNode.Parameters, param.Name, value))" />
                                break;
                            case "options":
                                <InputSelect class="form-select" 
                                             Value="@GetStringProperty(moduleNode.Parameters, param.Name)" 
                                             ValueChanged="@((string value) => SetStringProperty(moduleNode.Parameters, param.Name, value))">
                                    @if (param.Options != null)
                                    {
                                        @foreach (var option in param.Options)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    }
                                </InputSelect>
                                break;
                            // ---- FIM DA CORREÇÃO ----
                        }
                    </div>
                }
            </EditForm>
        }
    </div>
}
else
{
    <div class="properties-panel-placeholder">
        <p>Selecione um módulo para ver suas propriedades.</p>
    </div>
}

@code {
    [Parameter]
    public BaseNode? SelectedNode { get; set; }

    [Parameter]
    public Dictionary<string, ModuleManifest>? ManifestsMap { get; set; }

    private ModuleManifest? _manifestForNode;

    protected override void OnParametersSet()
    {
        if (SelectedNode is ModuleNode moduleNode && ManifestsMap != null && ManifestsMap.TryGetValue(moduleNode.ModuleType, out var manifest))
        {
            _manifestForNode = manifest;
        }
        else
        {
            _manifestForNode = null;
        }
    }

    // --- Métodos Auxiliares para Binding Dinâmico com Reflection ---
    private string GetStringProperty(object target, string propName)
    {
        return target.GetType().GetProperty(propName)?.GetValue(target) as string ?? "";
    }

    private void SetStringProperty(object target, string propName, string value)
    {
        target.GetType().GetProperty(propName)?.SetValue(target, value);
    }

    private decimal GetDecimalProperty(object target, string propName)
    {
        var val = target.GetType().GetProperty(propName)?.GetValue(target);
        return val is decimal d ? d : 0;
    }

    private void SetDecimalProperty(object target, string propName, decimal value)
    {
        target.GetType().GetProperty(propName)?.SetValue(target, value);
    }
}