@page "/builder/{AgentId}"
@using Blazor.Diagrams.Core
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams.Core.Models.Base
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Text.Json.Serialization.Metadata
@using IntelligentAutomation.Domain.Entities
@using IntelligentAutomation.Domain.Workflow
@using IntelligentAutomation.WebApp.Components.Shared
@using IntelligentAutomation.WebApp.Services
@inject ApiClient ApiClient
@inject Diagram Diagram

<PageTitle>Construtor de Agente</PageTitle>

<h3>Construtor do Agente: @AgentId</h3>

<div class="agent-builder-container">
    <div class="toolbox">
        <h4>Módulos</h4>
        @if (_catalog == null)
        {
            <p><em>Carregando catálogo...</em></p>
        }
        else
        {
            @foreach (var area in _catalog.Keys.OrderBy(k => k))
            {
                <details open>
                    <summary>@area</summary>
                    <ul>
                        @foreach (var module in _catalog[area])
                        {
                            <li class="draggable-module" draggable="true" @ondragstart="@(() => OnDragStart(module))">
                                @module.DisplayName
                            </li>
                        }
                    </ul>
                </details>
            }
        }
        <button class="btn btn-success mt-4 w-100" @onclick="SaveChanges">Salvar</button>
    </div>

    <div class="canvas-container"
         @ondrop="OnDrop"
         @ondragover:preventDefault="true">
        <CascadingValue Value="Diagram">
            <DiagramCanvas />
        </CascadingValue>
    </div>

    <PropertiesPanel SelectedNode="@_selectedNode" />
</div>

@code {
    [Parameter]
    public string AgentId { get; set; }

    // CORREÇÃO: Variáveis de estado declaradas
    private Dictionary<string, List<ModuleManifest>>? _catalog;
    private ModuleManifest? _draggedModule;
    private BaseNode? _selectedNode;

    // CORREÇÃO: Dicionário para mapear o nó visual (Diagrams) ao nosso nó de domínio (Workflow)
    private readonly Dictionary<string, BaseNode> _domainNodes = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Diagram.SelectionChanged += OnSelectionChanged;

        // CORREÇÃO: Carrega o catálogo de módulos da API
        _catalog = await ApiClient.GetModuleCatalog();

        // Lógica futura: Carregar a definição do agente existente da API.
        // Por enquanto, começamos com um gatilho padrão.
        var triggerDiagramNode = new NodeModel(new Point(50, 50));
        
        // 2. Cria o nosso nó de domínio.
        var triggerNode = new TriggerNode
        {
            // 3. Atribui o Id gerado pela biblioteca ao nosso objeto de domínio.
            Id = triggerDiagramNode.Id, 
            Name = "Gatilho Agendado", 
            PositionX = 50, 
            PositionY = 50
        };
        
        // 4. Agora, podemos atribuir as outras propriedades ao nó visual.
        triggerDiagramNode.Title = triggerNode.Name;
        triggerDiagramNode.AddPort(PortAlignment.Right);
        Diagram.Nodes.Add(triggerDiagramNode);
        _domainNodes[triggerDiagramNode.Id] = triggerNode;
    }

    // CORREÇÃO: Lida com a seleção, buscando o nó de domínio real no dicionário
    private void OnSelectionChanged(SelectableModel? model)
    {
        if (model is NodeModel selectedDiagramNode && _domainNodes.TryGetValue(selectedDiagramNode.Id, out var domainNode))
        {
            _selectedNode = domainNode;
        }
        else
        {
            _selectedNode = null;
        }
        StateHasChanged();
    }

    private void OnDragStart(ModuleManifest module)
    {
        _draggedModule = module;
    }

    private void OnDrop(DragEventArgs e)
    {
        if (_draggedModule == null) return;

        var position = Diagram.GetRelativeMousePoint(e.ClientX, e.ClientY);

        // CORREÇÃO: Cria o nó de domínio com base no manifesto do catálogo
        var moduleNode = new ModuleNode
        {
            ModuleType = _draggedModule.Type,
            Name = _draggedModule.DisplayName,
            PositionX = position.X,
            PositionY = position.Y,
            Parameters = CreateParametersForModule(_draggedModule.Type) // Cria parâmetros default
        };

        // Cria o nó visual correspondente
        var diagramNode = new NodeModel(new Point(position.X, position.Y));
        
        // 4. Agora, podemos atribuir as outras propriedades ao nó visual
        diagramNode.Title = moduleNode.Name;

        diagramNode.AddPort(PortAlignment.Left);
        diagramNode.AddPort(PortAlignment.Right);
        Diagram.Nodes.Add(diagramNode);

        // Adiciona ao nosso mapeamento de estado
        _domainNodes[diagramNode.Id] = moduleNode;
        _draggedModule = null;
    }

    // CORREÇÃO: Método auxiliar para instanciar os parâmetros corretos
    private BaseModuleParameters? CreateParametersForModule(string moduleType)
    {
        return moduleType switch
        {
            "HttpRequest" => new HttpRequestModuleParameters(),
            "BinancePlaceOrder" => new BinancePlaceOrderModuleParameters(),
            // Adicionar outros tipos de parâmetros aqui
            _ => null
        };
    }

    // CORREÇÃO: Lógica de salvar implementada
    private async Task SaveChanges()
    {
        if (!Guid.TryParse(AgentId, out var agentGuid))
        {
            Console.WriteLine("ID do Agente inválido!");
            return;
        }

        // Converte o estado do diagrama para o nosso modelo de domínio
        var definition = new WorkflowDefinition
        {
            Trigger = _domainNodes.Values.OfType<TriggerNode>().First(),
            Nodes = _domainNodes.Values.OfType<ModuleNode>().ToList<BaseNode>()
        };

        definition.Connections = Diagram.Links.Select(link =>
            {
                // Acessamos a propriedade 'Model' e fazemos o cast para (NodeModel)
                // Isso garante ao compilador que estamos lidando com um nó que tem uma propriedade 'Id'
                var sourceNode = link.Source.Model as NodeModel;
                var targetNode = link.Target.Model as NodeModel;

                // Verificação de segurança para evitar erros de referência nula
                if (sourceNode == null || targetNode == null)
                {
                    return null; // Ignora links inválidos ou incompletos
                }

                return new Connection
                {
                    SourceNodeId = sourceNode.Id,
                    TargetNodeId = targetNode.Id
                };
            })
            .Where(c => c != null) // Filtra quaisquer links inválidos que resultaram em nulo
            .ToList()!;

        try
        {
            await ApiClient.UpdateAgentDefinition(AgentId, definition);
            Console.WriteLine("Definição do agente salva com sucesso!"); // Substituir por um toast/notificação
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao salvar: {ex.Message}");
        }
    }

    // CORREÇÃO: Classe de serialização que estava faltando
    public class PolymorphicTypeResolver : DefaultJsonTypeInfoResolver
    {
        public override JsonTypeInfo GetTypeInfo(Type type, JsonSerializerOptions options)
        {
            JsonTypeInfo jsonTypeInfo = base.GetTypeInfo(type, options);
            if (jsonTypeInfo.Type == typeof(BaseModuleParameters))
            {
                jsonTypeInfo.PolymorphismOptions = new JsonPolymorphismOptions
                {
                    TypeDiscriminatorPropertyName = "$type",
                    IgnoreUnrecognizedTypeDiscriminators = true,
                    UnknownDerivedTypeHandling = JsonUnknownDerivedTypeHandling.FailSerialization,
                    DerivedTypes =
                    {
                        new JsonDerivedType(typeof(HttpRequestModuleParameters), "http"),
                        new JsonDerivedType(typeof(BinancePlaceOrderModuleParameters), "binanceOrder")
                    }
                };
            }
            return jsonTypeInfo;
        }
    }
}