@page "/builder/{AgentId}"
@using Blazor.Diagrams.Core
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams.Core.Models
@inject Diagram Diagram

<PageTitle>Construtor de Agente</PageTitle>

<h3>Construtor do Agente: @AgentId</h3>

<div class="agent-builder-container">
    <div class="toolbox">
        <h4>Módulos</h4>
        <div class="draggable-module" draggable="true" @ondragstart="@(() => OnDragStart("HttpRequest"))">
            Requisição HTTP
        </div>
        <div class="draggable-module" draggable="true" @ondragstart="@(() => OnDragStart("SendEmail"))">
            Enviar E-mail
        </div>
    </div>

    <div class="canvas-container" 
         @ondrop="OnDrop" 
         @ondragover:preventDefault="true">
        <CascadingValue Value="Diagram">
            <DiagramCanvas />
        </CascadingValue>
    </div>
</div>

@code {
    [Parameter]
    public string AgentId { get; set; }

    private string? _draggedModuleType;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // Lógica futura: Carregar a definição do agente do backend.
        // Por enquanto, começamos com um gatilho padrão.
        var triggerNode = new NodeModel(new Point(50, 50));
        triggerNode.Title = "Gatilho Agendado";
        triggerNode.AddPort(PortAlignment.Right);
        Diagram.Nodes.Add(triggerNode);
    }

    private void OnDragStart(string moduleType)
    {
        _draggedModuleType = moduleType;
    }

    private void OnDrop(DragEventArgs e)
    {
        if (string.IsNullOrEmpty(_draggedModuleType))
            return;

        // Converte as coordenadas do evento de drop para as coordenadas do diagrama
        var position = Diagram.GetRelativeMousePoint(e.ClientX, e.ClientY);

        var newNode = new NodeModel(position);
        newNode.Title = _draggedModuleType switch
        {
            "HttpRequest" => "Requisição HTTP",
            "SendEmail" => "Enviar E-mail",
            _ => "Módulo Desconhecido"
        };
        
        // Adiciona portas para conexão
        newNode.AddPort(PortAlignment.Left);
        newNode.AddPort(PortAlignment.Right);

        Diagram.Nodes.Add(newNode);
        
        _draggedModuleType = null;
    }
}