@page "/builder/{AgentId}"
@using Blazor.Diagrams.Core
@using Blazor.Diagrams.Core.Models
@using IntelligentAutomation.Domain.Workflow // Importa o modelo do workflow
@using IntelligentAutomation.WebApp.Services // Importa o ApiClient
@using IntelligentAutomation.WebApp.Components.Shared // Importa o painel
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Text.Json.Serialization.Metadata
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams.Core.Models.Base
@using IntelligentAutomation.Application.Services
@inject ApiClient ApiClient
@inject Diagram Diagram

<PageTitle>Construtor de Agente</PageTitle>

<h3>Construtor do Agente: @AgentId</h3>

<div class="agent-builder-container">
    <div class="toolbox">
        <h4>Módulos</h4>
        <div class="draggable-module" draggable="true" @ondragstart="@(() => OnDragStart("HttpRequest"))">
            Requisição HTTP
        </div>
        <div class="draggable-module" draggable="true" @ondragstart="@(() => OnDragStart("SendEmail"))">
            Enviar E-mail
        </div>
        <button class="btn btn-success mt-4 w-100" @onclick="SaveChanges">Salvar</button>
    </div>

    <div class="canvas-container" 
         @ondrop="OnDrop" 
         @ondragover:preventDefault="true">
        <CascadingValue Value="Diagram">
            <DiagramCanvas />
        </CascadingValue>
    </div>
    
    <PropertiesPanel SelectedNode="@_selectedNode" />
</div>

@code {
    [Parameter]
    public string AgentId { get; set; }

    private string? _draggedModuleType;
    private BaseNode? _selectedNode;

    private static JsonSerializerOptions _jsonOptions = new() 
    {
        // Habilita a escrita de propriedades aninhadas de forma legível
        WriteIndented = true, 
        // Adiciona um discriminador de tipo para que o deserializador saiba qual classe concreta usar
        Converters = { new JsonStringEnumConverter() },
        TypeInfoResolver = new PolymorphicTypeResolver() 
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Diagram.SelectionChanged += OnSelectionChanged;

        var triggerNode = new TriggerNode { Name = "Gatilho Agendado", PositionX = 50, PositionY = 50 };
        var triggerDiagramNode = new NodeModel(new Point(triggerNode.PositionX, triggerNode.PositionY)) 
        {
            Title = triggerNode.Name,
            Id = triggerNode.Id
        };
        triggerDiagramNode.AddPort(PortAlignment.Right);
        Diagram.Nodes.Add(triggerDiagramNode);
    }

    private void OnSelectionChanged(SelectableModel model)
    {
        if (model is NodeModel selectedNode)
        {
            // Encontrar o nó correspondente em nosso modelo de dados
            // Esta lógica precisará ser aprimorada quando carregarmos dados
            _selectedNode = new ModuleNode { Id = selectedNode.Id, Name = selectedNode.Title }; 
        }
        else
        {
            _selectedNode = null;
        }
        StateHasChanged();
    }

    private void OnDragStart(string moduleType)
    {
        _draggedModuleType = moduleType;
    }

    private void OnDrop(DragEventArgs e)
    {
        if (string.IsNullOrEmpty(_draggedModuleType))
            return;

        var position = Diagram.GetRelativeMousePoint(e.ClientX, e.ClientY);
        
        var moduleNode = new ModuleNode
        {
            ModuleType = _draggedModuleType,
            PositionX = position.X,
            PositionY = position.Y
        };
        
        // Atribui título e parâmetros com base no tipo
        switch (_draggedModuleType)
        {
            case "HttpRequest":
                moduleNode.Name = "Requisição HTTP";
                moduleNode.Parameters = new HttpRequestModuleParameters();
                break;
            case "SendEmail":
                moduleNode.Name = "Enviar E-mail";
                moduleNode.Parameters = new SendEmailModuleParameters();
                break;
        }

        var diagramNode = new NodeModel(position)
        {
            Title = moduleNode.Name,
            Id = moduleNode.Id
        };
        
        diagramNode.AddPort(PortAlignment.Left);
        diagramNode.AddPort(PortAlignment.Right);
        Diagram.Nodes.Add(diagramNode);
        
        _draggedModuleType = null;
    }
    
    // O método SaveChanges precisa ser atualizado para usar as novas classes
    // (A lógica de conversão se tornará mais complexa e será implementada na próxima etapa)
    private async Task SaveChanges() { /* Lógica de salvar será atualizada */ }

    // Adicionar esta classe auxiliar no final do bloco @code
}