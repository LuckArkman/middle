@page "/admin/users"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Gerenciar Usuários</PageTitle>

<h3>Gerenciar Usuários</h3>

<table class="table">
    <thead>
    <tr>
        <th>Email</th>
        <th>Plano Atual</th>
        <th>Data de Registro</th>
        <th>Ações</th>
    </tr>
    </thead>
    <tbody>
    @* Lógica para listar usuários da API *@
    <tr>
        <td>cliente1@email.com</td>
        <td>Intermediário</td>
        <td>@DateTime.Now.AddDays(-10).ToString("d")</td>
        <td>
            <button class="btn btn-sm btn-warning">Alterar Plano</button>
        </td>
    </tr>
    </tbody>
</table>