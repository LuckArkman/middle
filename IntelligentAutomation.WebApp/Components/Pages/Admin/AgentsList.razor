@page "/agents"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using IntelligentAutomation.Application.Dtos
@using IntelligentAutomation.Domain.Entities
@using IntelligentAutomation.WebApp.Services
@using Microsoft.AspNetCore.Authorization
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject ApiClient ApiClient
@inject NotificationService NotificationService
@inject ToastService Toast

<h3>Meus Agentes</h3>

<div class="row mb-3">
    <div class="col-md-8">
        <!-- ---- INÍCIO DA CORREÇÃO ---- -->
        <!-- O @bind foi removido. Agora usamos a vinculação unidirecional 'value' -->
        <!-- e um único manipulador de evento '@oninput' que faz todo o trabalho. -->
        <input type="text" class="form-control" placeholder="Buscar por nome..."
               value="@_searchTerm"
               @oninput="OnSearchInput" />
        <!-- ---- FIM DA CORREÇÃO ---- -->
    </div>
    <div class="col-md-4 text-end">
        <button class="btn btn-primary" @onclick="CreateNewAgent" disabled="@_isLoading">
            @if (_isLoading)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            }
            else
            {
                <span class="bi bi-plus-circle"></span>
            }
            Novo Agente
        </button>
    </div>
</div>

@if (_pagedResult == null)
{
    <p><em>Carregando agentes...</em></p>
}
else if (_pagedResult.Items.Count == 0)
{
    <div class="text-center p-5 border rounded">
        <span class="bi bi-robot" style="font-size: 3rem;"></span>
        <h4 class="mt-3">Nenhum agente encontrado</h4>
        <p>Você ainda não criou nenhum agente de automação. Clique no botão abaixo para começar!</p>
        <button class="btn btn-primary" @onclick="CreateNewAgent">
            <span class="bi bi-plus-circle"></span> Criar Meu Primeiro Agente
        </button>
    </div>
}
else
{
    <table class="table table-hover">
        <thead>
        <tr>
            <th>Nome</th>
            <th>Status</th>
            <th>Última Atividade</th>
            <th>Ações</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var agent in _pagedResult.Items)
        {
            <tr>
                <td>@agent.Name</td>
                <td><span class="badge @GetStatusBadgeClass(agent.Status)">@agent.Status</span></td>
                <td>@(agent.UpdatedAt?.ToString("g") ?? "N/A")</td>
                <td>
                    <button class="btn btn-sm btn-info" @onclick='() => Navigation.NavigateTo($"/builder/{agent.Id}")'>Editar</button>
                    <button class="btn btn-sm btn-danger" @onclick="() => StopAgent(agent.Id)">Parar</button>
                </td>
            </tr>
        }
        </tbody>
    </table>

    @* Adicionar componente de Paginação aqui *@
}

@code {
    private bool _isLoading = false;
    private PagedResult<AgentDto>? _pagedResult;
    private string? _searchTerm;
    private int _currentPage = 1;
    private int _totalPages = 1;
    private const int PageSize = 10;

    private Timer? _searchTimer;

    protected override async Task OnInitializedAsync()
    {
        _searchTimer = new Timer(OnSearchTimerElapsed, null, Timeout.Infinite, Timeout.Infinite);
        await NotificationService.StartConnectionAsync();
        NotificationService.OnAgentStatusChanged += HandleAgentStatusChange;
        await LoadData(_currentPage);
    }

    private async Task LoadData(int page)
    {
        _currentPage = page;
        try
        {
            _pagedResult = await ApiClient.GetAgentsAsync(_searchTerm, _currentPage, PageSize);
            _totalPages = (int)Math.Ceiling(_pagedResult.TotalCount / (double)PageSize);
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Erro ao carregar agentes: {ex.Message}");
        }
        StateHasChanged();
    }

    // O método OnSearchInput já está correto para esta implementação
    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString();
        _searchTimer?.Change(500, Timeout.Infinite);
    }

    private void OnSearchTimerElapsed(object? state)
    {
        InvokeAsync(() => LoadData(1));
    }

    private void HandleAgentStatusChange(string agentId, string newStatus)
    {
        var agentToUpdate = _pagedResult?.Items.FirstOrDefault(a => a.Id == agentId);
        if (agentToUpdate != null)
        {
            agentToUpdate.Status = newStatus;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task CreateNewAgent()
    {
        _isLoading = true;
        try
        {
            var newAgentDto = new CreateAgentDto { Name = "Novo Agente Sem Título" };
            var createdAgent = await ApiClient.CreateAgentAsync(newAgentDto);
            Navigation.NavigateTo($"/builder/{createdAgent.Id}");
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Erro ao criar agente: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task StopAgent(string agentId)
    {
        try
        {
            await ApiClient.StopAgentAsync(agentId);
            await Toast.ShowSuccess("Comando para parar o agente foi enviado.");
            await LoadData(_currentPage);
        }
        catch(Exception ex)
        {
            await Toast.ShowError($"Erro ao parar agente: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (NotificationService != null)
        {
            NotificationService.OnAgentStatusChanged -= HandleAgentStatusChange;
            await NotificationService.DisposeAsync();
        }
        _searchTimer?.Dispose();
    }

    private string GetStatusBadgeClass(string? status)
    {
        return status?.ToLower() switch
        {
            "running" => "bg-success",
            "stopped" => "bg-secondary",
            "error" => "bg-danger",
            _ => "bg-info"
        };
    }
}