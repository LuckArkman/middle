@page "/admin"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Painel Administrativo</PageTitle>

<h1>Painel Administrativo</h1>
<p>Gerencie os recursos e usuários da plataforma.</p>

<div class="list-group">
    <a href="/admin/plans" class="list-group-item list-group-item-action">Gerenciar Planos</a>
    <a href="/admin/modules" class="list-group-item list-group-item-action">Gerenciar Módulos</a>
    <a href="/admin/users" class="list-group-item list-group-item-action">Gerenciar Usuários</a>
</div>