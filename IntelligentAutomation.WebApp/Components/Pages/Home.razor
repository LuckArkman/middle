@page "/"
@layout PublicLayout

<PageTitle>AutoAgent - Automação Inteligente para Empresas</PageTitle>

<!-- Hero Section -->
<section id="hero" class="hero-section">
    <div class="container">
        <div class="text-center hero-content">
            <span class="hero-badge">
                <i class="bi bi-lightning-charge-fill"></i> Automação Inteligente para Empresas
            </span>
            <h1 class="hero-title">
                Transforme Processos<br>
                em Agentes Autônomos<br>
                de Alta Performance
            </h1>
            <p class="hero-subtitle">
                Crie, configure e escale agentes de automação inteligentes com nosso construtor visual.<br>
                Sem código, com total controle e observabilidade em tempo real.
            </p>
            <div class="hero-buttons">
                <a href="#pricing" class="btn btn-primary btn-lg">
                    Ver Planos <i class="bi bi-arrow-right ms-2"></i>
                </a>
                <a href="#how-it-works" class="btn btn-outline-dark btn-lg">Como Funciona</a>
            </div>
            <div class="hero-features">
                <div class="feature-item">
                    <i class="bi bi-shield-lock"></i>
                    <span>Segurança Enterprise</span>
                </div>
                <div class="feature-item">
                    <i class="bi bi-graph-up-arrow"></i>
                    <span>Métricas em Tempo Real</span>
                </div>
                <div class="feature-item">
                    <i class="bi bi-lightning-charge"></i>
                    <span>Setup em Minutos</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section id="how-it-works" class="section-light">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">PROCESSO SIMPLES</span>
            <h2 class="section-title">Como Funciona</h2>
            <p class="section-description">
                Da ideia à automação em produção em poucos passos. Nosso processo foi desenhado para máxima eficiência.
            </p>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-lg-3 col-md-6">
                <div class="step-card text-center">
                    <div class="step-icon">
                        <i class="bi bi-cursor-fill"></i>
                    </div>
                    <h6 class="step-number">PASSO 01</h6>
                    <h4 class="step-title">Crie seu Agente</h4>
                    <p class="step-description">
                        Use nosso construtor visual drag-and-drop para criar agentes personalizados sem escrever uma linha de código.
                    </p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="step-card text-center">
                    <div class="step-icon">
                        <i class="bi bi-gear-fill"></i>
                    </div>
                    <h6 class="step-number">PASSO 02</h6>
                    <h4 class="step-title">Configure Gatilhos</h4>
                    <p class="step-description">
                        Defina gatilhos, módulos e regras de negócio para que seu agente execute tarefas automaticamente.
                    </p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="step-card text-center">
                    <div class="step-icon">
                        <i class="bi bi-play-fill"></i>
                    </div>
                    <h6 class="step-number">PASSO 03</h6>
                    <h4 class="step-title">Execute e Monitore</h4>
                    <p class="step-description">
                        Coloque seus agentes em produção com observabilidade completa e logs detalhados em tempo real.
                    </p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="step-card text-center">
                    <div class="step-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <h6 class="step-number">PASSO 04</h6>
                    <h4 class="step-title">Escale sem Limites</h4>
                    <p class="step-description">
                        Aumente a capacidade conforme sua demanda cresce, com infraestrutura elástica e isolamento garantido.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="features" class="section-white">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">FUNCIONALIDADES</span>
            <h2 class="section-title">Tudo que Você Precisa</h2>
            <p class="section-description">
                Uma plataforma completa para criar, gerenciar e escalar seus agentes de automação com confiança.
            </p>
        </div>
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-card-icon">
                        <i class="bi bi-columns-gap"></i>
                    </div>
                    <h4 class="feature-card-title">Construtor Visual</h4>
                    <p class="feature-card-text">
                        Interface drag-and-drop intuitiva para criar fluxos de automação complexos sem conhecimento técnico.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-card-icon">
                        <i class="bi bi-lock-fill"></i>
                    </div>
                    <h4 class="feature-card-title">Isolamento & Segurança</h4>
                    <p class="feature-card-text">
                        Cada agente roda em ambiente isolado com criptografia end-to-end e em conformidade com a LGPD.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-card-icon">
                        <i class="bi bi-broadcast"></i>
                    </div>
                    <h4 class="feature-card-title">Observabilidade Total</h4>
                    <p class="feature-card-text">
                        Monitore execuções, logs e métricas em tempo real com alertas personalizáveis.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-card-icon">
                        <i class="bi bi-cloud-arrow-up-fill"></i>
                    </div>
                    <h4 class="feature-card-title">Escala Automática</h4>
                    <p class="feature-card-text">
                        Infraestrutura elástica que se adapta automaticamente à demanda dos seus agentes.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-card-icon">
                        <i class="bi bi-hdd-stack-fill"></i>
                    </div>
                    <h4 class="feature-card-title">APIs & Webhooks</h4>
                    <p class="feature-card-text">
                        Integre com qualquer sistema através de APIs RESTful e webhooks configuráveis.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-card-icon">
                        <i class="bi bi-calendar2-week-fill"></i>
                    </div>
                    <h4 class="feature-card-title">Agendamento Flexível</h4>
                    <p class="feature-card-text">
                        Programe execuções recorrentes com cron expressions ou triggers baseados em eventos.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Pricing Section -->
<section id="pricing" class="section-light">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">PLANOS & PREÇOS</span>
            <h2 class="section-title">Escolha o Plano Ideal</h2>
            <p class="section-description">
                Planos flexíveis que crescem com seu negócio. Sem surpresas, sem taxas ocultas.
            </p>
        </div>
        <div class="row g-4 justify-content-center align-items-stretch">
            <!-- Plano Básico -->
            <div class="col-lg-3 col-md-6">
                <div class="pricing-card">
                    <h3 class="pricing-name">Básico</h3>
                    <div class="pricing-price">
                        <span class="price-amount">R$ 97</span>
                        <span class="price-period">/mês</span>
                    </div>
                    <p class="pricing-description">Ideal para começar a automatizar processos simples</p>
                    <ul class="pricing-features">
                        <li><i class="bi bi-check-lg"></i> 2 agentes ativos</li>
                        <li><i class="bi bi-check-lg"></i> 5 módulos disponíveis</li>
                        <li><i class="bi bi-check-lg"></i> 1.000 execuções/mês</li>
                        <li><i class="bi bi-check-lg"></i> Logs por 7 dias</li>
                        <li><i class="bi bi-check-lg"></i> Suporte por email</li>
                    </ul>
                    <a href="Account/Register" class="btn btn-outline-dark w-100">Começar Agora</a>
                </div>
            </div>

            <!-- Plano Intermediário -->
            <div class="col-lg-3 col-md-6">
                <div class="pricing-card">
                    <h3 class="pricing-name">Intermediário</h3>
                    <div class="pricing-price">
                        <span class="price-amount">R$ 197</span>
                        <span class="price-period">/mês</span>
                    </div>
                    <p class="pricing-description">Para equipes que precisam de mais automações</p>
                    <ul class="pricing-features">
                        <li><i class="bi bi-check-lg"></i> 5 agentes ativos</li>
                        <li><i class="bi bi-check-lg"></i> 10 módulos disponíveis</li>
                        <li><i class="bi bi-check-lg"></i> 5.000 execuções/mês</li>
                        <li><i class="bi bi-check-lg"></i> Logs por 30 dias</li>
                        <li><i class="bi bi-check-lg"></i> Suporte prioritário</li>
                        <li><i class="bi bi-check-lg"></i> Webhooks ilimitados</li>
                    </ul>
                    <a href="Account/Register" class="btn btn-outline-dark w-100">Começar Agora</a>
                </div>
            </div>

            <!-- Plano Pro (Destaque) -->
            <div class="col-lg-3 col-md-6">
                <div class="pricing-card pricing-card-featured">
                    <span class="pricing-badge">MAIS POPULAR</span>
                    <h3 class="pricing-name">Pro</h3>
                    <div class="pricing-price">
                        <span class="price-amount">R$ 397</span>
                        <span class="price-period">/mês</span>
                    </div>
                    <p class="pricing-description">Máximo poder para operações em escala</p>
                    <ul class="pricing-features">
                        <li><i class="bi bi-check-lg"></i> 10 agentes ativos</li>
                        <li><i class="bi bi-check-lg"></i> 15 módulos disponíveis</li>
                        <li><i class="bi bi-check-lg"></i> 20.000 execuções/mês</li>
                        <li><i class="bi bi-check-lg"></i> Logs por 90 dias</li>
                        <li><i class="bi bi-check-lg"></i> Suporte 24/7</li>
                        <li><i class="bi bi-check-lg"></i> API avançada</li>
                        <li><i class="bi bi-check-lg"></i> Ambiente dedicado</li>
                    </ul>
                    <a href="Account/Register" class="btn btn-light w-100">Escolher Pro</a>
                </div>
            </div>

            <!-- Plano Empresarial -->
            <div class="col-lg-3 col-md-6">
                <div class="pricing-card">
                    <h3 class="pricing-name">Empresarial</h3>
                    <div class="pricing-price">
                        <span class="price-amount-custom">Sob consulta</span>
                    </div>
                    <p class="pricing-description">Soluções personalizadas para grandes empresas</p>
                    <ul class="pricing-features">
                        <li><i class="bi bi-check-lg"></i> 20+ agentes ativos</li>
                        <li><i class="bi bi-check-lg"></i> Todos os módulos</li>
                        <li><i class="bi bi-check-lg"></i> Execuções ilimitadas</li>
                        <li><i class="bi bi-check-lg"></i> Logs ilimitados</li>
                        <li><i class="bi bi-check-lg"></i> Gerente de sucesso dedicado</li>
                        <li><i class="bi bi-check-lg"></i> SLA garantido</li>
                        <li><i class="bi bi-check-lg"></i> Customizações</li>
                        <li><i class="bi bi-check-lg"></i> On-premise disponível</li>
                    </ul>
                    <a href="#contact" class="btn btn-outline-dark w-100">Falar com Vendas</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section id="contact" class="section-white">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">ENTRE EM CONTATO</span>
            <h2 class="section-title">Pronto para Começar?</h2>
            <p class="section-description">
                Preencha o formulário abaixo e nossa equipe entrará em contato para entender suas necessidades.
            </p>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="contact-form-card">
                    <form>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label for="name" class="form-label">Nome *</label>
                                <input type="text" class="form-control form-control-lg" id="name"
                                       placeholder="Seu nome completo" required>
                            </div>
                            <div class="col-md-6">
                                <label for="email" class="form-label">E-mail *</label>
                                <input type="email" class="form-control form-control-lg" id="email"
                                       placeholder="seu@email.com" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="company" class="form-label">Empresa (opcional)</label>
                            <input type="text" class="form-control form-control-lg" id="company"
                                   placeholder="Nome da sua empresa">
                        </div>
                        <div class="mb-4">
                            <label for="message" class="form-label">Mensagem (opcional)</label>
                            <textarea class="form-control form-control-lg" id="message" rows="4"
                                      placeholder="Conte-nos sobre suas necessidades de automação..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-dark btn-lg w-100">
                            Enviar Mensagem <i class="bi bi-send-fill ms-2"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>