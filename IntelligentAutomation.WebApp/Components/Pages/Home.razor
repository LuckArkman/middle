        </div>
        <!-- CORREÇÃO: Estrutura HTML validada para garantir que os cards sejam filhos diretos do grid -->
        <div class="pricing-grid">
            <div class="pricing-card">
                <h3>Básico</h3>
                <p class="price">R$ 97<span>/mês</span></p>
                <p class="description">Ideal para começar a automatizar processos simples</p>
                <ul>
                    <li><span class="bi bi-check"></span> 2 agentes ativos</li>
                    <li><span class="bi bi-check"></span> 5 módulos disponíveis</li>
                    <li><span class="bi bi-check"></span> 1.000 execuções/mês</li>
                    <li><span class="bi bi-check"></span> Logs por 7 dias</li>
