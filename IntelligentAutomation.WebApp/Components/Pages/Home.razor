                <a href="Account/Register" class="btn btn-primary-outline">Começar Agora</a>
            </div>
            <div class="pricing-card">
                <h3>Intermediário</h3>
                <p class="price">R$ 197<span>/mês</span></p>
                <p class="description">Para equipes que precisam de mais automações</p>
                <ul>
